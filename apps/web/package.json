{
  "name": "todotube-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/embed.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npm run e2e && wrangler deploy",
    "e2e": "playwright test --trace off",
    "postinstall": "node scripts/patchShaka.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "bgutils-js": "^4.0.3",
    "googlevideo": "^5.0.1",
    "shaka-player": "^5.2.16",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "https-proxy-agent": "^7.0.6",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "wrangler": "4.158.0"
  }
}
