{
  "name": "todotube-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/embed.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npm run e2e && wrangler deploy",
    "postinstall": "node scripts/patch-shaka-types.mjs",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "shaka-player": "^4.16.54"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "https-proxy-agent": "^7.0.6",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "wrangler": "4.152.0"
  }
}
